        <mxCell id="api" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=20;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;Azure Container Apps&lt;/b&gt;&lt;div style=&quot;font-size:16px;margin-top:6px&quot;&gt;&lt;b&gt;C# / ASP.NET Core&lt;/b&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:6px&quot;&gt;- liefert Webseite und Web-API&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:6px&quot;&gt;- API prüft Dokumenttyo (PDF, Word, JPG oder PNG) und maximal grösse von 10 MB.&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:6px&quot;&gt;- Retourniert Fehler&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:6px&quot;&gt;- Speichert gültige Uploads&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:6px&quot;&gt;- Bedient Liste und Download.&lt;/div&gt;" vertex="1">
          <mxGeometry height="203" width="380" x="525" y="92" as="geometry" />
        </mxCell>
        <mxCell id="blob" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=20;fontColor=#193941;fillColor=#f1f6f8;strokeColor=#afc7ce;" value="&lt;b&gt;Azure Blob Storage&lt;/b&gt;&lt;div style=&quot;font-size:16px;margin-top:6px&quot;&gt;- Original unter eindeutiger Datei-ID speichern.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:6px&quot;&gt;- Name, Grösse und Uploadzeit&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:6px&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:6px&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:6px&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:6px&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:6px&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:6px&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:6px&quot;&gt;- Json-Ergebnis&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:6px&quot;&gt;- Status&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:6px&quot;&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
