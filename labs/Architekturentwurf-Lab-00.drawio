        <mxCell id="s2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=17;fontColor=#193941;fillColor=#dcefeb;strokeColor=none;" value="&lt;b&gt;Ausbaustufe 2   /   Nach dem Upload asynchron verarbeiten     ·     F5–F8&lt;/b&gt;" vertex="1">
