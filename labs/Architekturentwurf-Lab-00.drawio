        <mxCell id="ui" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=20;fontColor=#193941;fillColor=#f1f6f8;strokeColor=#afc7ce;" value="&lt;b&gt;Browser · HTML und JavaScript&lt;/b&gt;&lt;div style=&quot;font-size:16px;margin-top:6px&quot;&gt;Lädt die Seite von App - JavaScript sendet Dateien per Drag &amp;amp; Drop, aktualisiert die Liste mit Name, Grösse, Uploadzeit und Status und bietet den Originaldownload an.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
