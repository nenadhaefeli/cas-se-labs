        <mxCell id="queue" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=20;fontColor=#193941;fillColor=#f1f6f8;strokeColor=#afc7ce;" value="&lt;b&gt;Azure Event Grid und Queue Storage&lt;/b&gt;&lt;div style=&quot;font-size:16px;margin-top:6px&quot;&gt;Event Grid leitet BlobCreated für den Original-Container an die Queue weiter. Sie puffert den Verweis auf die Datei, bis diese weiterverarbeitet wird.&lt;/div&gt;" vertex="1">
          <mxGeometry height="146" width="370" x="1050" y="560" as="geometry" />
        </mxCell>
        <mxCell id="worker" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=20;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;Azure Function App&lt;/b&gt;&lt;div style=&quot;font-size:16px;margin-top:6px&quot;&gt;&lt;b&gt;C# / .NET, Queue-Trigger.&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:6px&quot;&gt;- Separat bereitgestellter Worker.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:6px&quot;&gt;- Liest das Original aus Blob Storage&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:6px&quot;&gt;- Bereitet Text oder Bild auf&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:6px&quot;&gt;- Ruft das Modell mit dem vordefinierten prompt auf&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="370" x="616" y="439" as="geometry" />
        </mxCell>
        <mxCell id="model" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Modell-Endpunkt&lt;/b&gt;&lt;div style=&quot;font-size:16px;margin-top:6px&quot;&gt;- Modell analysiert Text und Bilder.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:6px&quot;&gt;- Es antwortet dem Worker mit Kategorie, Titel, Kurzfassung, Schlagwörtern und fachlichen Feldern als JSON.&lt;/div&gt;" vertex="1">
